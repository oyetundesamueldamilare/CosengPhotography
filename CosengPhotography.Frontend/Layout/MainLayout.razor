@inherits LayoutComponentBase

<div class="master-wrapper">
    <header class="navbar navbar-expand-lg navbar-dark bg-black sticky-top px-4 shadow-sm" style="height: 70px;">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a class="navbar-brand font-monospace tracking-wide text-uppercase" href="/" style="font-weight: 800; letter-spacing: 2px; color: #fff; text-decoration: none;">
                COSENG <span style="font-weight: 300; color: #aaa;">PHOTOGRAPHY</span>
            </a>

            <nav class="d-flex align-items-center gap-2">
                <a href="/" class="btn btn-link text-white text-decoration-none small px-3 navigation-link">Home</a>
                <a href="/about" class="btn btn-link text-white text-decoration-none small px-3 navigation-link">About Us</a>
                <a href="/dashboard" class="btn btn-light btn-sm font-weight-bold px-3 py-2 ms-2 core-portal-btn" style="border-radius: 0; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;">
                    Admin Portal →
                </a>
            </nav>
        </div>
    </header>

    <main class="content-body">
        @Body
    </main>

    <footer class="system-footer text-center py-4 bg-white border-top">
        <div class="container">
            <p class="text-muted small mb-0">© 2026 Coseng Photography. All Rights Preserved. Core Engine V1.0</p>
        </div>
    </footer>
</div>

<style>
    .tracking-wide {
        letter-spacing: 0.15em;
    }

    .bg-black {
        background-color: #000000 !important;
    }

    /* CRITICAL STICKY FOOTER ENGINE: Flex layout structure forcing standard document rules */
    .master-wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh; /* Ensures layout is at least full-screen tall */
        background-color: #fafafa;
        font-family: 'Inter', Arial, sans-serif;
    }

    .content-body {
        flex: 1 0 auto; /* Grows to take up all empty space, pushing the footer down */
    }

    .system-footer {
        flex-shrink: 0; /* Prevents footer from flattening or warping */
        width: 100%;
    }

    /* Interactive UI Nav Links Hover styling */
    .navigation-link {
        font-size: 14px;
        opacity: 0.8;
        transition: opacity 0.2s ease;
    }

        .navigation-link:hover {
            opacity: 1;
            color: #fff !important;
        }

    .core-portal-btn {
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .core-portal-btn:hover {
            background-color: #ddd !important;
        }
</style>