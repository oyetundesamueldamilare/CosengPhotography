@page "/Portal"

<div class="animate-fade-in">
    <!-- Hero Section -->
    <section class="hero bg-black text-white">
        <div class="row w-100 m-0 align-items-center">

            <!-- Hero Text -->
            <div class="col-lg-6 hero-text">
                <span class="section-label">Digital Asset Management Container</span>
                <h1 class="hero-title">
                    PRESERVING <br />MOMENTS, <br /><span class="hero-subtitle">SECURELY.</span>
                </h1>
                <p class="hero-description">
                    A decoupled client-delivery portal built for high-tier performance. Upload original photo assets, encrypt distribution spaces, and dispatch custom client pipelines seamlessly.
                </p>

                <div class="d-flex gap-3">
                    <a href="/dashboard" class="btn btn-outline-light btn-premium">
                        Launch Dashboard Context
                    </a>
                </div>
            </div>

            <!-- Hero Graphic -->
            <div class="col-lg-6 d-none d-lg-flex justify-content-center align-items-center position-relative">
                <div class="square-graphic-wrapper">
                    <div class="border-accent"></div>
                    <div class="glass-card-preview">
                        <div class="d-flex justify-content-between mb-4">
                            <figure>
                                <img src="images/image2.jpg" alt="Active Kernel Preview" class="img-fluid" />
                                <figcaption class="text-white small">Active Kernel</figcaption>
                            </figure>
                            <figure>
                                <img src="images/image1.jpg" alt="Photography Banner Preview" class="img-fluid" />
                            </figure>
                        </div>
                        <h4 class="font-monospace text-white mb-1">Secure Footprint Delivery Engine</h4>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- Capabilities Section -->
    <section class="capabilities container my-5 py-5">
        <div class="text-center mb-5">
            <h2 class="capabilities-title">System Pipeline Core Capabilities</h2>
            <hr class="section-divider" />
        </div>

        <div class="row g-4 text-start">
            <div class="col-md-4">
                <div class="card capability-card">
                    <div class="fs-2 mb-3">📁</div>
                    <h5>Simple Storage System</h5>
                    <p class="text-muted small mb-0">Streams original file byte streams straight into localized infrastructure containers with near-zero latency degradation.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card capability-card">
                    <div class="fs-2 mb-3">🔒</div>
                    <h5>Security</h5>
                    <p class="text-muted small mb-0">Automatic generation of unique token authenticators, completely hiding customer collections from unauthorized scrapers.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card capability-card">
                    <div class="fs-2 mb-3">⚡</div>
                    <h5>High Performance</h5>
                    <p class="text-muted small mb-0">Leverages the power of client-side WebAssembly rendering or interactive server state synchronizations for lightning-fast photo loads.</p>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    /* Layout */
    .hero {
        min-height: 75vh;
        display: flex;
        align-items: center;
        overflow: hidden;
        position: relative;
        padding: 0;
    }

    .hero-text {
        padding: 5rem 10% 5rem 10%;
        text-align: left;
    }

    /* Typography */
    .section-label {
        text-transform: uppercase;
        letter-spacing: 4px;
        color: #888;
        font-size: 0.85rem;
        margin-bottom: 1rem;
        display: block;
    }

    .hero-title {
        font-weight: 800;
        letter-spacing: -2px;
        line-height: 1.05;
        margin-bottom: 1.5rem;
    }

    .hero-subtitle {
        font-weight: 300;
        color: #aaa;
    }

    .hero-description {
        max-width: 500px;
        color: #caa;
        font-size: 1.1rem;
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .capabilities-title {
        text-transform: uppercase;
        letter-spacing: 3px;
        font-weight: bold;
        font-family: monospace;
        font-size: 1.25rem;
    }

    .section-divider {
        max-width: 60px;
        border-top: 3px solid #000;
        margin: 15px auto;
    }

    /* Buttons */
    .btn-premium {
        border-radius: 0;
        font-size: 13px;
        font-weight: bold;
        transition: all 0.3s ease;
        text-transform: uppercase;
        font-family: monospace;
    }

    .btn-premium:hover {
        background-color: #fff !important;
        color: #000 !important;
    }

    /* Abstract UI Art Elements */
    .square-graphic-wrapper {
        position: relative;
        width: 400px;
        height: 400px;
        background: linear-gradient(135deg, #111 0%, #222 100%);
        border: 1px solid #333;
    }

    .border-accent {
        position: absolute;
        top: -15px;
        right: -15px;
        width: 100%;
        height: 100%;
        border: 2px solid #fff;
        opacity: 0.15;
        z-index: 0;
    }

    .glass-card-preview {
        position: absolute;
        bottom: -30px;
        left: -30px;
        width: 350px;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.1);
        padding: 25px;
        z-index: 2;
    }

    .capability-card {
        padding: 1.5rem;
        height: 100%;
        border: 0;
        border-radius: 0;
        background: #fff;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    /* Animations */
    .animate-fade-in {
        animation: fadeIn 0.8s ease-out forwards;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
