@page "/"

<div class="animate-fade-in">
    <!-- Sophisticated Photography Hero Banner -->
    <header class="portfolio-hero position-relative d-flex align-items-center justify-content-center text-center">
        <div class="portfolio-hero-overlay"></div>
        <div class="portfolio-hero-content text-white z-2">
            <span class="portfolio-subtitle">Fine Art & Commercial Photography</span>
            <h1 class="portfolio-title">COSENG STUDIOS</h1>
            <p class="portfolio-tagline">Visual storytelling framed through precise, high-tier clarity.</p>
            <div class="d-flex justify-content-center gap-3 mt-4">
                <a href="#gallery-section" class="btn btn-light btn-portfolio text-uppercase">View Showcase</a>
                <a href="/Portal" class="btn btn-outline-light btn-portfolio text-uppercase">Client Portal Access</a>
            </div>
        </div>
    </header>

    <!-- Interactive Portfolio Showcase Grid -->
    <section id="gallery-section" class="container my-5 py-5">
        <div class="text-center mb-5">
            <h2 class="section-title">Selected Works Matrix</h2>
            <p class="text-muted small text-uppercase tracking-wide">Filter through core production focus scopes</p>
            <hr class="section-divider-dark" />
        </div>

        <!-- Filter Navigation -->
        <div class="d-flex justify-content-center gap-2 mb-5 flex-wrap">
            <button class="btn btn-sm @(SelectedCategory == "All" ? "btn-dark" : "btn-outline-dark") filter-btn" @onclick='() => FilterCategory("All")'>All Works</button>
            <button class="btn btn-sm @(SelectedCategory == "Weddings" ? "btn-dark" : "btn-outline-dark") filter-btn" @onclick='() => FilterCategory("Weddings")'>Weddings</button>
            <button class="btn btn-sm @(SelectedCategory == "Portraits" ? "btn-dark" : "btn-outline-dark") filter-btn" @onclick='() => FilterCategory("Portraits")'>Portraits</button>
            <button class="btn btn-sm @(SelectedCategory == "Commercial" ? "btn-dark" : "btn-outline-dark") filter-btn" @onclick='() => FilterCategory("Commercial")'>Commercial</button>
        </div>

        <!-- Image Matrix Grid -->
        <div class="row g-4">
            @foreach (var work in FilteredWorks)
            {
                <div class="col-sm-6 col-md-4">
                    <div class="matrix-card overflow-hidden position-relative">
                        <img src="@work.ImageUrl" alt="@work.Title" class="w-100 matrix-image" />
                        <div class="matrix-overlay position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-end p-4">
                            <h5 class="text-white mb-1 font-monospace tracking-wide">@work.Title</h5>
                            <span class="badge align-self-start bg-light text-dark font-monospace text-uppercase" style="font-size: 10px;">@work.Category</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private string SelectedCategory { get; set; } = "All";

    private List<SampleWork> FilteredWorks => SelectedCategory == "All"
        ? SamplePortfolio
        : SamplePortfolio.Where(w => w.Category == SelectedCategory).ToList();

    private void FilterCategory(string category)
    {
        SelectedCategory = category;
    }

    private List<SampleWork> SamplePortfolio { get; set; } = new()
    {
        new SampleWork { Title = "The Eternity Veil", Category = "Weddings", ImageUrl = "images/image1.jpg" },
        new SampleWork { Title = "Monochrome Editorial V1", Category = "Portraits", ImageUrl = "images/image2.jpg" },
        new SampleWork { Title = "Architectural Geometric", Category = "Commercial", ImageUrl = "images/image1.jpg" },
        new SampleWork { Title = "Golden Hour Romance", Category = "Weddings", ImageUrl = "images/image2.jpg" },
        new SampleWork { Title = "Studio Identity Study", Category = "Portraits", ImageUrl = "images/image1.jpg" },
        new SampleWork { Title = "Product Luminescence", Category = "Commercial", ImageUrl = "images/image2.jpg" }
    };

    public class SampleWork
    {
        public string Title { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string ImageUrl { get; set; } = string.Empty;
    }
}

<style>
    /* Hero Section Configurations */
    .portfolio-hero {
        height: 75vh;
        min-height: 500px;
        /* Using your existing image asset as the premium background */
        background: url('images/image1.jpg') center/cover no-repeat fixed;
        overflow: hidden;
    }

    .portfolio-hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.5));
        z-index: 1;
    }

    .portfolio-subtitle {
        text-transform: uppercase;
        letter-spacing: 5px;
        font-size: 0.85rem;
        color: #bbb;
        display: block;
        margin-bottom: 1rem;
        font-family: monospace;
    }

    .portfolio-title {
        font-size: 3.5rem;
        font-weight: 900;
        letter-spacing: 4px;
        margin-bottom: 1rem;
    }

    .portfolio-tagline {
        font-size: 1.1rem;
        color: #eee;
        max-width: 600px;
        margin: 0 auto;
        font-weight: 300;
    }

    /* Core UI Elements */
    .btn-portfolio {
        border-radius: 0;
        padding: 0.6rem 1.5rem;
        font-size: 12px;
        font-weight: bold;
        letter-spacing: 1px;
        font-family: monospace;
        transition: all 0.3s ease;
    }

    .section-title {
        text-transform: uppercase;
        letter-spacing: 3px;
        font-weight: 800;
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .tracking-wide {
        letter-spacing: 2px;
    }

    .section-divider-dark {
        max-width: 50px;
        border-top: 3px solid #000;
        margin: 15px auto;
        opacity: 1;
    }

    .filter-btn {
        border-radius: 0;
        font-family: monospace;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 1px;
        padding: 0.4rem 1.2rem;
    }

    /* Visual Matrix Interactions */
    .matrix-card {
        background: #000;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .matrix-image {
        height: 400px;
        object-fit: cover;
        transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .matrix-overlay {
        background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0) 100%);
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .matrix-card:hover .matrix-image {
        transform: scale(1.05);
        opacity: 0.85;
    }

    .matrix-card:hover .matrix-overlay {
        opacity: 1;
    }

    /* System Animations */
    .animate-fade-in {
        animation: fadeIn 0.8s ease-out forwards;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>